{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "./rules/python-conventions.md",
    "./rules/testing-conventions.md",
    "./rules/session-artifact-promotion.md",
    "./rules/auto-commit.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "uv *": "allow",
      "pip *": "allow",
      "poetry *": "allow",
      "nix *": "allow",
      "*": "ask"
    }
  }
}
