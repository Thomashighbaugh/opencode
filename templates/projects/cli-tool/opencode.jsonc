{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "./rules/cli-conventions.md",
    "./rules/session-artifact-promotion.md",
    "./rules/auto-commit.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "cargo *": "allow",
      "go *": "allow",
      "npm *": "allow",
      "nix *": "allow",
      "*": "ask"
    }
  }
}
