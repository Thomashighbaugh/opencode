{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.2:cloud",
  "default_agent": "my-agent",
  "agent": {
    "my-agent": {
      "extends": "hubs",
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "instructions": [
    "AGENTS.md",
    "./rules/my-rule.md"
  ],
  "permission": {
    "bash": "allow",
    "read": "allow"
  }
}
