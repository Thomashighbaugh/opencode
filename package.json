{
  "scripts": {
    "check-agents": "node skills/agent-format-enforcer/scripts/check-agent-format.ts",
    "check-schema": "node skills/config-sync/scripts/check-schema-compliance.ts",
    "check-all": "npm run check-agents && npm run check-schema",
    "fix-agents": "node skills/agent-format-enforcer/scripts/check-agent-format.ts --fix",
    "fix-schema": "node skills/config-sync/scripts/check-schema-compliance.ts --fix",
