    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "js-yaml": "^5.5.0",
    "jsonc-parser": "^3.3.1",
    "jsonpath-plus": "^10.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
