{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "hubs",
    "formatter": true,
    "lsp": true,
    "provider": {
        "profundo": {
            "name": "Profundo AI",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://api.profundoai.com/v1"
            },
            // Model list synced with GET /v1/models. Context windows follow Profundo's
            // published model pages; output caps were verified against the live API
            // (max_tokens above each model's cap returns 503). Cost is omitted because
            // Profundo bills flat-rate, not per token.
            "models": {
                // Anthropic
                "claude-opus-5": {
                    "name": "Claude Opus 5",
                    "family": "claude-opus",
                    "release_date": "2026-07-24",
                    "attachment": true,
                    "reasoning": true,
                    "temperature": false,
                    "tool_call": true,
                    "limit": { "context": 200000, "output": 128000 },
                    "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
                },
                "claude-opus-4-8": {
                    "name": "Claude Opus 4.8",
                    "family": "claude-opus",
                    "release_date": "2026-05-28",
                    "attachment": true,
                    "reasoning": true,
                    "temperature": false,
                    "tool_call": true,
