    },
    "permission": {
        "edit": {
            ".opencode/**": "allow"
        },
        "websearch": "allow",
        "webfetch": "allow",
        "lsp": "allow",
        "bash": {
            "*": "allow",
            "grep *": "ask",
            "rg *": "ask"
        },
        "read": "allow",
        "grep": "ask",
        "glob": "allow",
        "skill": "allow",
        "task": "allow",
        "todowrite": "allow",
        "question": "allow"
    },
    "mcp": {
        "context7": {
            "enabled": true,
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            },
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "searxng": {
            "command": [
                "npx",
                "-y",
                "mcp-searxng"
            ],
            "enabled": true,
            "environment": {
                "SEARXNG_URL": "http://localhost:8080"
            },
            "type": "local"
        },
        "gh_grep": {
            "enabled": true,
            "type": "remote",
            "url": "https://mcp.grep.app"
        }
    },
    "plugin": [
        "./plugins/hooks/hooks.ts",
        "./plugins/command-hooks/plugin.ts",
        "./plugins/prompt-queue/plugin.ts",
        "./plugins/auto-continue/plugin.ts",
        "@opencode-plugins/env-protection",
        "@franlol/opencode-md-table-formatter@0.0.3"
    ],
    "instructions": [
        "AGENTS.md",
        "./rules/shell_strategy.md",
        "./rules/context-strategy.md",
        "./rules/file-operations.md",
        "./rules/security.md",
        "./rules/karpathy-guidelines.md",
        "./rules/hub-description-directive.md",
        "./rules/output-compression.md",
        "./rules/writing-style.md",
        "./rules/anti-sycophancy.md",
        "./rules/anti-refusal.md",
        "./rules/efficiency-first.md",
        "./rules/hub-menu-rebuild.md",
        "./rules/session-artifact-promotion.md",
        "./rules/auto-commit.md",
        "./rules/code-search-first.md",
        "./rules/ax-first.md"
    ],
    "references": {
        "context": {
            "path": "./.opencode/context",
            "description": "Durable project wiki — decisions, patterns, frameworks, preferences, docs, and digested research. Start at index.md; every page is addressable as a [[wiki-link]]."
        },
        "context-research": {
            "path": "./.opencode/context/research",
            "description": "Digested external sources — one page per agent harness, plugin, memory system, writing guide, or paper. These replace the external repository clones that used to be listed here."
        }
    },
}
